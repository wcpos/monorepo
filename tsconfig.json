{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"baseUrl": ".",
		"module": "esnext",
		"paths": {
			// Linked worker packages must use the app's RxDB/native types, not their dev dependencies.
			"rxdb": ["node_modules/rxdb"],
			"rxdb/*": ["node_modules/rxdb/*"],
			"react-native": ["node_modules/react-native"],
			"react-native/*": ["node_modules/react-native/*"],
			"react-native-worklets": ["node_modules/react-native-worklets"],
			"@wcpos/rxdb-storage-worklet": ["node_modules/@wcpos/rxdb-storage-worklet", "apps/main/node_modules/@wcpos/rxdb-storage-worklet/src/index.ts"],
			"@wcpos/worklet-opfs": ["node_modules/@wcpos/worklet-opfs", "apps/main/node_modules/@wcpos/worklet-opfs/src/index.ts"],
			"@wcpos/react-native-worklet-fs": ["node_modules/@wcpos/react-native-worklet-fs", "apps/main/node_modules/@wcpos/react-native-worklet-fs/src/index.ts"],
			"@wcpos/printer/ipc-channels": ["packages/printer/src/ipc/channels.cts"],
			"@wcpos/main/*": ["apps/main/*"],
			"@wcpos/electron/*": ["apps/electron/*"],
			"@wcpos/order-math": ["packages/order-math/src/index"],
			"react-native-resizable-panels": ["packages/resizable-panels/src/index"],
			"react-native-resizable-panels/*": ["packages/resizable-panels/src/*"],
			"@wcpos/scanner": ["packages/scanner/src/index"],
			"@wcpos/scanner/*": ["packages/scanner/src/*"],
			"@wcpos/order-math/*": ["packages/order-math/src/*"],
			"@wcpos/components/*": ["packages/components/src/*"],
			"@wcpos/core/*": ["packages/core/src/*"],
			"@wcpos/database": ["packages/database/src/index"],
			"@wcpos/database/*": ["packages/database/src/*"],
			"@wcpos/hooks/*": ["packages/hooks/src/*"],
			"@wcpos/receipt-renderer": ["packages/receipt-renderer/src/index"],
			"@wcpos/receipt-renderer/*": ["packages/receipt-renderer/src/*"],
			"@wcpos/printer": ["packages/printer/src/index"],
			"@wcpos/printer/*": ["packages/printer/src/*"],
			"@wcpos/query": ["packages/query/src/index"],
			"@wcpos/query/*": ["packages/query/src/*"],
			"@wcpos/utils/*": ["packages/utils/src/*"],
		}
	},
	"include": ["**/*.ts", "**/*.tsx"]
}
