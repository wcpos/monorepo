{
	"name": "react-native-resizable-panels",
	"version": "0.1.1",
	"description": "Resizable panel groups for React Native — web, Electron, iOS and Android",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wcpos/monorepo.git",
		"directory": "packages/resizable-panels"
	},
	"license": "MIT",
	"keywords": [
		"react-native",
		"resizable",
		"panels",
		"split-pane",
		"reanimated",
		"gesture-handler"
	],
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public",
		"main": "dist/index.js",
		"types": "dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist",
		"check:publish": "pnpm build && node scripts/check-publish.mjs",
		"test": "jest",
		"lint": "eslint src --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-native": "*",
		"react-native-gesture-handler": ">=2.24.0",
		"react-native-reanimated": ">=4.0.0",
		"react-native-worklets": ">=0.5.0",
		"react-native-web": "*"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^30.0.0",
		"jest": "^30.5.0",
		"jest-environment-jsdom": "^30.5.0",
		"react-dom": "19.2.3",
		"react-native-web": "^0.21.2",
		"ts-jest": "^29.4.12"
	},
	"peerDependenciesMeta": {
		"react-native": {
			"optional": true
		},
		"react-native-web": {
			"optional": true
		}
	}
}
