{
	"name": "@wcpos/printer",
	"version": "1.9.1",
	"description": "Printer encoding and transport for WooCommerce POS",
	"author": "kilbot <paul@kilbot.com>",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./encoder": "./src/encoder/index.ts",
		"./encoder/render-preview": "./src/encoder/render-preview.ts",
		"./ipc-channels": "./src/ipc/channels.cts",
		"./transport/device-key": "./src/transport/device-key.ts"
	},
	"typesVersions": {
		"*": {
			"transport/device-key": [
				"src/transport/device-key.ts"
			]
		}
	},
	"files": [
		"src/**",
		"ipc-channels.d.ts"
	],
	"scripts": {
		"lint": "eslint src",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@point-of-sale/receipt-printer-encoder": "^3.0.3",
		"@point-of-sale/webbluetooth-receipt-printer": "2.0.0",
		"@point-of-sale/webusb-receipt-printer": "2.0.0",
		"@wcpos/receipt-renderer": "workspace:*",
		"@wcpos/utils": "workspace:*",
		"jpeg-js": "0.4.4",
		"p-queue": "^9.3.3",
		"upng-js": "2.1.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@types/upng-js": "2.1.5",
		"jsdom": "^30.0.1",
		"react-dom": "19.2.7",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"expo-modules-core": ">=55.0.0",
		"expo-print": ">=55.0.0",
		"react-native-ble-plx": ">=3.0.0",
		"react-native-esc-pos-printer": ">=4.0.0",
		"react-native-star-io10": ">=1.0.0",
		"react-native-tcp-socket": ">=6.0.0"
	},
	"peerDependenciesMeta": {
		"expo-modules-core": {
			"optional": true
		},
		"expo-print": {
			"optional": true
		},
		"react-native-tcp-socket": {
			"optional": true
		},
		"react-native-ble-plx": {
			"optional": true
		},
		"react-native-esc-pos-printer": {
			"optional": true
		},
		"react-native-star-io10": {
			"optional": true
		}
	}
}
