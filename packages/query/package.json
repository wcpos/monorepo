		"@wcpos/order-math": "workspace:*",
		"@wcpos/sync-core": "workspace:*",
		"@wcpos/sync-engine": "workspace:*",
		"@wcpos/utils": "workspace:*",
		"date-fns": "^4.4.0",
		"lodash": "^4.18.1",
		"observable-hooks": "^4.2.4",
		"rxdb": "17.6.0",
		"rxjs": "7.8.2",
		"expo-crypto": "~58.0.6"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.26",
		"ajv": "^8.20.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"ts-jest": "29.4.12",
		"z-schema": "12.4.6"
	}
}
