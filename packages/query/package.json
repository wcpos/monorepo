{
	"name": "@wcpos/query",
	"version": "1.9.1",
	"description": "Query and Replication for WooCommerce POS",
	"author": "kilbot <paul@kilbot.com>",
	"license": "MIT",
	"private": true,
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts",
		"./collection-map": "./src/collection-map.ts",
		"./register-session": "./src/register-session/index.ts",
		"./register-session/new-till-flag": "./src/register-session/new-till-flag.ts",
		"./temporary-order": "./src/temporary-order/index.ts",
		"./mutations": "./src/mutations/index.ts",
		"./receipt-email-queue": "./src/receipt-email-queue/index.ts",
		"./user-db": "./src/user-db/index.ts",
		"./user-db/bootstrap": "./src/user-db/bootstrap.ts"
	},
	"type": "module",
	"files": [
		"src/**"
	],
	"scripts": {
		"clean": "shx rm -rf dist && rm -rf node_modules",
		"test": "NODE_OPTIONS=--experimental-vm-modules pnpm exec jest",
		"lint": "eslint src --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
		"typecheck": "bash -c '! tsc --noEmit 2>&1 | grep -q \"^src/.*error TS\"'"
