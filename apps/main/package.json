{
	"name": "@wcpos/main",
	"main": "expo-router/entry",
	"version": "1.10.6",
	"scripts": {
		"dev": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"test:plugins": "node --test plugins/*.test.js",
		"test:e2e": "playwright test",
		"test:e2e:native": "maestro test .maestro",
		"test:e2e:native:check": "node ../../scripts/check-maestro-testids.mjs",
		"test:e2e:native:seed": "node ../../scripts/e2e-native-seed.mjs",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"typecheck": "expo customize tsconfig.json && node -e \"require('fs').accessSync('.expo/types/router.d.ts')\" && tsc --noEmit",
		"build": "expo export --output-dir ./build --platform all",
		"build:web": "expo export --output-dir ./web-build --platform=web",
		"build:electron": "ELECTRON=true expo export --output-dir ./electron-build --platform=web",
		"eas-build-pre-install": "[ \"$EAS_BUILD_PLATFORM\" = \"android\" ] && sudo apt-get update && sudo apt-get install -y libsecret-1-dev || true",
		"eas-build-post-install": "pnpm run -w build:main",
		"lint": "eslint app components --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint app components --ext .js,.jsx,.ts,.tsx --fix"
	},
	"jest": {
		"preset": "jest-expo",
		"testPathIgnorePatterns": [
			"/node_modules/",
			"<rootDir>/e2e/",
			"<rootDir>/plugins/",
			"<rootDir>/metro/"
		]
	},
	"expo": {
		"install": {
			"exclude": [
				"jest"
			]
		},
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false,
				"exclude": [
					"react-native-star-io10",
					"react-native-tcp-socket"
				]
			}
		}
	},
	"dependencies": {
		"@expo/metro-runtime": "~57.0.10",
		"@react-native-community/netinfo": "12.0.1",
		"@shopify/flash-list": "2.0.2",
		"@shopify/react-native-skia": "2.6.2",
		"@tailwindcss/postcss": "^4.3.3",
		"@wcpos/components": "workspace:*",
		"@wcpos/core": "workspace:*",
		"@wcpos/database": "workspace:*",
		"@wcpos/hooks": "workspace:*",
		"@wcpos/printer": "workspace:*",
		"@wcpos/query": "workspace:*",
		"@wcpos/sync-core": "workspace:*",
		"@wcpos/sync-engine": "workspace:*",
		"@wcpos/utils": "workspace:*",
		"expo": "~57.0.13",
		"expo-audio": "~57.0.3",
		"expo-auth-session": "~57.0.7",
		"expo-blob": "~57.0.1",
		"expo-blur": "~57.0.2",
		"expo-camera": "~57.0.3",
		"expo-constants": "~57.0.12",
		"expo-crypto": "~57.0.1",
		"expo-dev-client": "~57.0.12",
		"expo-file-system": "~57.0.4",
		"expo-haptics": "~57.0.1",
		"expo-image": "~57.0.3",
		"expo-linking": "~57.0.6",
		"expo-localization": "~57.0.1",
		"expo-opfs": "^1.0.9",
		"expo-print": "~57.0.1",
		"expo-router": "~57.0.13",
		"expo-sharing": "~57.0.12",
		"expo-splash-screen": "~57.0.6",
		"expo-system-ui": "~57.0.2",
		"expo-web-browser": "~57.0.2",
		"js-base64": "^3.9.3",
		"observable-hooks": "4.2.4",
		"postcss": "^8.5.26",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.2",
		"react-native-ble-plx": "3.5.1",
		"react-native-device-info": "^15.0.2",
		"react-native-edge-to-edge": "^1.8.1",
		"react-native-esc-pos-printer": "4.5.0",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-keyboard-controller": "1.21.9",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.2",
		"react-native-star-io10": "1.12.1",
		"react-native-svg": "15.15.4",
		"react-native-tcp-socket": "^6.4.2",
		"react-native-web": "^0.21.2",
		"react-native-webview": "13.16.1",
		"react-native-worklets": "0.10.1",
		"tailwindcss": "^4.3.3",
		"uniwind": "1.11.0",
		"victory-native": "^42.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@playwright/test": "^1.62.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.18",
		"babel-plugin-transform-remove-console": "^6.9.4",
		"dotenv": "^17.4.2",
		"expo-atlas": "^0.4.3",
		"jest": "^30.4.2",
		"jest-expo": "~57.0.4",
		"react-native-nitro-modules": "0.35.9",
		"tw-animate-css": "^1.4.0"
	},
	"private": true
}
