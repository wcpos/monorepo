{
	"name": "@wcpos/main",
	"main": "expo-router/entry",
	"version": "2.0.0",
	"scripts": {
		"dev": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"test:plugins": "node --test plugins/*.test.js",
		"test:e2e": "playwright test",
		"test:e2e:native": "maestro test .maestro",
		"test:e2e:native:check": "node ../../scripts/check-maestro-testids.mjs",
		"test:e2e:native:seed": "node ../../scripts/e2e-native-seed.mjs",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"typecheck": "expo customize tsconfig.json && node -e \"require('fs').accessSync('.expo/types/router.d.ts')\" && tsc --noEmit",
		"build": "expo export --output-dir ./build --platform all",
		"build:web": "expo export --output-dir ./web-build --platform=web",
		"build:electron": "ELECTRON=true expo export --output-dir ./electron-build --platform=web",
		"eas-build-pre-install": "[ \"$EAS_BUILD_PLATFORM\" = \"android\" ] && sudo apt-get update && sudo apt-get install -y libsecret-1-dev || true",
		"eas-build-post-install": "pnpm run -w build:main",
		"lint": "eslint app components --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint app components --ext .js,.jsx,.ts,.tsx --fix"
	},
	"expo": {
		"install": {
			"exclude": [
				"jest"
			]
		},
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false,
				"exclude": [
					"react-native-star-io10",
					"react-native-tcp-socket"
				]
			}
		}
	},
	"dependencies": {
		"@config-plugins/react-native-webrtc": "15.0.2",
		"@expo/dom-webview": "~58.0.2",
		"@expo/metro-runtime": "~58.0.17",
		"@react-native-community/netinfo": "12.0.1",
		"@react-native-masked-view/masked-view": "0.3.2",
		"@sentry/react-native": "~8.28.0",
		"@shopify/flash-list": "2.3.2",
		"@shopify/react-native-skia": "2.14.0",
		"@stripe/stripe-terminal-react-native": "0.0.1-beta.34",
		"@tailwindcss/postcss": "^4.3.4",
		"@wcpos/components": "workspace:*",
		"@wcpos/core": "workspace:*",
		"@wcpos/database": "workspace:*",
		"@wcpos/hooks": "workspace:*",
		"@wcpos/order-math": "workspace:*",
		"@wcpos/printer": "workspace:*",
		"@wcpos/query": "workspace:*",
		"@wcpos/sync-core": "workspace:*",
		"@wcpos/sync-engine": "workspace:*",
		"@wcpos/utils": "workspace:*",
		"expo": "~58.0.23",
		"expo-application": "~58.1.2",
		"expo-audio": "~58.0.11",
		"expo-auth-session": "~58.0.17",
		"expo-blob": "~58.0.3",
		"expo-blur": "~58.0.5",
		"expo-build-properties": "~58.0.12",
		"expo-camera": "~58.0.14",
		"expo-constants": "~58.0.15",
		"expo-crypto": "~58.0.7",
		"expo-dev-client": "~58.0.18",
		"expo-device": "~58.0.5",
		"expo-file-system": "~58.0.13",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.18",
		"expo-linking": "~58.0.16",
		"expo-localization": "~58.0.5",
		"expo-observe": "~58.0.18",
		"expo-print": "~58.0.8",
		"expo-router": "~58.0.30",
		"expo-sharing": "~58.0.22",
		"expo-splash-screen": "~58.0.13",
		"expo-sqlite": "~58.0.15",
		"expo-system-ui": "~58.0.7",
		"expo-updates": "~58.0.21",
		"expo-web-browser": "~58.0.7",
		"js-base64": "^3.9.6",
		"observable-hooks": "4.2.4",
		"postcss": "^8.5.32",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-ble-plx": "3.5.1",
		"react-native-device-info": "^15.0.2",
		"react-native-edge-to-edge": "^1.8.1",
		"react-native-esc-pos-printer": "4.5.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-star-io10": "1.14.0",
		"react-native-svg": "15.16.0",
		"react-native-tcp-socket": "^6.4.3",
		"react-native-web": "~0.21.4",
		"react-native-webrtc": "124.0.8",
		"react-native-webview": "14.0.1",
		"react-native-worklets": "0.13.0",
		"tailwindcss": "^4.3.4",
		"uniwind": "1.13.1",
		"victory-native": "^43.0.1"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@playwright/test": "^1.64.1",
		"@react-native/jest-preset": "0.88.1",
		"@testing-library/react-native": "14.1.0",
		"@types/react": "^19.3.0",
		"babel-plugin-transform-remove-console": "^6.9.4",
		"dotenv": "^18.0.9",
		"expo-atlas": "^0.4.3",
		"jest": "^30.5.2",
		"jest-expo": "~58.0.14",
		"react-native-nitro-modules": "0.37.2",
		"tw-animate-css": "^1.4.0"
	},
	"private": true
}
